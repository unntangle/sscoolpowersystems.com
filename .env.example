# Copy to .env.local and fill in. Never commit real values.
# Set SKIP_ENV_VALIDATION=1 only for CI or before the Shopify store exists.

# --- Shopify Storefront (Headless channel) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Preferred: private token, server-side only.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional: public token (only if a browser ever needs direct Storefront access).
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# --- Shopify Admin API (server-only: seed script, Draft Orders, quotes) ---
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-07

# --- Shopify webhooks -> /api/revalidate (HMAC secret from the app's API credentials) ---
SHOPIFY_WEBHOOK_SECRET=

# --- Later phases (optional for now) ---
DATABASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SENTRY_DSN=

# --- Public (safe for the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
